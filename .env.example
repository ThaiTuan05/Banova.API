# ============================================================
# Banova API — biến môi trường khi deploy (copy thành .env hoặc
# nhập trực tiếp vào phần Environment Variables của host).
# KHÔNG commit file .env thật — repo chỉ giữ .env.example.
# ============================================================

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# SQL Server cloud (Azure SQL / MonsterASP / SQL Server riêng).
# LocalDB chỉ chạy được trên máy dev, KHÔNG dùng khi deploy.
ConnectionStrings__Default=Server=your-server.database.windows.net;Database=BanovaDb;User Id=banova;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=true

# Bắt buộc >= 32 ký tự. Sinh bằng: openssl rand -base64 48
Jwt__Secret=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# Origin của FE được phép gọi API (thêm nhiều domain: __0, __1, __2...)
Cors__AllowedOrigins__0=https://banova-virid.vercel.app
Cors__AllowedOrigins__1=http://localhost:5173
