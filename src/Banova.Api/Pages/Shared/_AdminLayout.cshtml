@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string NavClass(string page) => currentPage.Equals(page, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Banova Admin</title>
    <style>
        :root {
            --primary: #012d1d;
            --primary-soft: #1b4332;
            --secondary: #006c48;
            --secondary-soft: #92f7c3;
            --surface: #f6f9f7;
            --card: #ffffff;
            --text: #0d1c2e;
            --muted: #5b6b61;
            --border: #dbe5df;
            --danger: #ba1a1a;
            --danger-soft: #ffdad6;
            --warn: #8a5a00;
            --warn-soft: #fff3d6;
            --radius: 12px;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: var(--surface);
            color: var(--text);
            font-size: 14px;
            line-height: 1.55;
        }

        a { color: var(--secondary); text-decoration: none; }
        a:hover { text-decoration: underline; }

        .shell { display: flex; min-height: 100vh; }

        .sidebar {
            width: 236px;
            flex: 0 0 236px;
            background: var(--primary);
            color: #e7f2ec;
            padding: 20px 14px;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .brand { display: flex; align-items: center; gap: 10px; padding: 0 6px; }
        .brand-mark {
            width: 36px; height: 36px; border-radius: 10px;
            background: var(--secondary-soft); color: var(--primary);
            display: grid; place-items: center; font-weight: 800; font-size: 18px;
        }
        .brand-text { font-weight: 700; font-size: 16px; letter-spacing: .3px; }
        .brand-sub { font-size: 11px; opacity: .7; text-transform: uppercase; letter-spacing: .12em; }

        .nav { display: flex; flex-direction: column; gap: 4px; }
        .nav-link {
            color: #cfe4d8; padding: 10px 12px; border-radius: 10px;
            display: flex; align-items: center; gap: 10px; font-weight: 600;
        }
        .nav-link:hover { background: rgba(255, 255, 255, .08); text-decoration: none; color: #fff; }
        .nav-link.active { background: var(--secondary-soft); color: var(--primary); }
        .nav-link .icon { font-size: 16px; }

        .sidebar-foot { margin-top: auto; font-size: 11px; opacity: .6; padding: 0 8px; }

        .main { flex: 1; min-width: 0; display: flex; flex-direction: column; }

        .topbar {
            background: var(--card);
            border-bottom: 1px solid var(--border);
            padding: 12px 24px;
            display: flex; align-items: center; justify-content: space-between; gap: 16px;
        }
        .topbar-title { font-weight: 700; font-size: 15px; }
        .topbar-user { display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 13px; }

        .content { padding: 24px; max-width: 1180px; width: 100%; }

        h1 { font-size: 22px; margin: 0 0 4px; }
        h2 { font-size: 17px; margin: 0 0 12px; }
        .page-sub { color: var(--muted); margin: 0 0 20px; font-size: 13px; }

        .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-bottom: 24px; }
        .card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 16px;
        }
        .card-label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
        .card-value { font-size: 26px; font-weight: 800; margin-top: 4px; }

        .panel {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 18px; margin-bottom: 20px;
        }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        @@media (max-width: 900px) {
            .shell { flex-direction: column; }
            .sidebar { width: 100%; flex: none; flex-direction: row; align-items: center; overflow-x: auto; }
            .sidebar-foot { display: none; }
            .nav { flex-direction: row; }
            .grid-2 { grid-template-columns: 1fr; }
        }

        .field { display: flex; flex-direction: column; gap: 5px; margin-bottom: 12px; }
        .field label { font-weight: 600; font-size: 12px; color: var(--muted); }
        input[type="text"], input[type="email"], input[type="password"], input[type="number"], select, textarea {
            width: 100%; padding: 9px 11px; border: 1px solid var(--border);
            border-radius: 9px; font: inherit; color: var(--text); background: #fff;
        }
        input:focus, select:focus, textarea:focus { outline: 2px solid var(--secondary-soft); border-color: var(--secondary); }
        textarea { resize: vertical; min-height: 90px; }

        .btn {
            display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
            border: 1px solid transparent; border-radius: 9px;
            padding: 9px 14px; font: inherit; font-weight: 700;
            background: var(--primary); color: #fff;
        }
        .btn:hover { background: var(--primary-soft); text-decoration: none; }
        .btn-outline { background: #fff; color: var(--primary); border-color: var(--border); }
        .btn-outline:hover { background: var(--surface); }
        .btn-danger { background: #fff; color: var(--danger); border-color: var(--danger-soft); }
        .btn-danger:hover { background: var(--danger-soft); }
        .btn-sm { padding: 6px 10px; font-size: 12px; }

        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
        th { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
        tr:last-child td { border-bottom: none; }
        .table-wrap { overflow-x: auto; }

        .badge {
            display: inline-block; padding: 3px 9px; border-radius: 999px;
            font-size: 11px; font-weight: 700; background: var(--surface); border: 1px solid var(--border);
        }
        .badge-ok { background: var(--secondary-soft); border-color: var(--secondary-soft); color: var(--primary); }
        .badge-warn { background: var(--warn-soft); border-color: var(--warn-soft); color: var(--warn); }
        .badge-danger { background: var(--danger-soft); border-color: var(--danger-soft); color: var(--danger); }

        .alert { padding: 11px 14px; border-radius: 10px; margin-bottom: 16px; font-weight: 600; }
        .alert-ok { background: var(--secondary-soft); color: var(--primary); }
        .alert-error { background: var(--danger-soft); color: var(--danger); }

        .auth-wrap { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
        .auth-card { width: 100%; max-width: 380px; background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 28px; }
        .auth-card h1 { font-size: 20px; margin-bottom: 4px; }
        .auth-note { color: var(--muted); font-size: 12px; margin-top: 14px; }

        .row-actions { display: flex; gap: 8px; flex-wrap: wrap; }
        .muted { color: var(--muted); }
        .mono { font-family: Consolas, "Courier New", monospace; font-size: 12px; }
        details summary { cursor: pointer; color: var(--secondary); font-weight: 600; }
    </style>
</head>
<body>
@if (isAuthenticated)
{
    <div class="shell">
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-mark">B</div>
                <div>
                    <div class="brand-text">Banova</div>
                    <div class="brand-sub">Quản trị</div>
                </div>
            </div>

            <nav class="nav">
                <a class="@NavClass("/Admin/Index")" asp-page="/Admin/Index"><span class="icon">▦</span> Tổng quan</a>
                <a class="@NavClass("/Admin/san-pham")" asp-page="/Admin/san-pham"><span class="icon">▤</span> Sản phẩm</a>
                <a class="@NavClass("/Admin/bai-viet")" asp-page="/Admin/bai-viet"><span class="icon">✎</span> Bài viết</a>
                <a class="@NavClass("/Admin/don-hang")" asp-page="/Admin/don-hang"><span class="icon">▣</span> Đơn hàng</a>
            </nav>

            <div class="sidebar-foot">Banova Admin · ASP.NET Core</div>
        </aside>

        <div class="main">
            <header class="topbar">
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-user">
                    <span>@User.Identity?.Name</span>
                    <form method="post" asp-page="/Admin/dang-nhap" asp-page-handler="Logout" style="margin:0">
                        <button type="submit" class="btn btn-outline btn-sm">Đăng xuất</button>
                    </form>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <div class="auth-wrap">
        @RenderBody()
    </div>
}
</body>
</html>
